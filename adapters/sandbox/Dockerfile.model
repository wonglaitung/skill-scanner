FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8090

RUN useradd --create-home --uid 10001 skill
RUN pip install --no-cache-dir "httpx>=0.27,<1"

WORKDIR /workspace
USER skill

HEALTHCHECK --interval=30s --timeout=3s \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8090') + '/health')"

ENTRYPOINT ["python", "adapters/skill_server.py"]
